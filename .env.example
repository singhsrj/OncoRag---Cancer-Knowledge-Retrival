# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-alb-dns-name.amazonaws.com,api.yourdomain.com

# --- CORS (comma-separated origins your React app is served from) ---
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000

# --- RAG pipeline (already used by helper.py) ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAG_DEFAULT_TOP_K=3

# --- gunicorn tuning (optional) ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
